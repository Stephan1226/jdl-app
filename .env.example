# 이 파일을 .env 로 복사해서 값을 채우세요. (cp .env.example .env)

# ── Supabase (인증) ───────────────────────────────────────────────────────────
# 대시보드 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# publishable key (구 anon key를 넣어도 동작)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-or-anon-key>"
# 서버 전용 — 시드(prisma/seed.mts)의 데모 유저 생성에만 사용. 절대 클라이언트에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── 데이터베이스 (Prisma → Supabase Postgres) ────────────────────────────────
# 대시보드 → Project Settings → Database → Connection string
# ⚠️ 비밀번호에 특수문자가 있으면 URL 인코딩하세요. 특히 '$' 는 반드시 '%24' 로!
#    Next.js(@next/env)가 .env 로드 시 '$xxx' 를 변수로 확장해 비밀번호를 망가뜨립니다.
#    (예: 비번 'a$b1234' → 'a%24b1234'. ':' '@' '/' '?' '#' '&' 등도 인코딩 권장)
# 런타임(앱): 풀드 연결(Supavisor transaction mode, 6543) + ?pgbouncer=true
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# 마이그레이션/CLI: 다이렉트 연결(5432). IPv4 환경이면 세션 풀러(5432)를 쓰세요.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ── Kakao (Daum 책 검색) ─────────────────────────────────────────────────────
# https://developers.kakao.com → 앱 → 앱 키 → REST API 키
# 서버 전용. 절대 클라이언트에 노출하지 마세요.
KAKAO_REST_API_KEY="<REST-API-키>"

# ── OpenRouter (AI 기능 — 목표 다음 할 일 제안 · 도서 추천) ──────────────────
# https://openrouter.ai → Keys
# 서버 전용. 절대 클라이언트에 노출하지 마세요.
OPENROUTER_API_KEY="<openrouter-api-key>"
